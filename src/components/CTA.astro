---
import { Image } from 'astro:assets';
import StoreButtons from './StoreButtons.astro';
import SectionHeading from './SectionHeading.astro';
import landscape from '../assets/golf-course-landscape.png';
---
<section class="relative overflow-hidden py-28 lg:py-40">
  <div class="absolute inset-0 -z-10">
    <Image
      src={landscape}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="lazy"
      format="webp"
      quality={70}
      class="h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-[linear-gradient(180deg,var(--void)_0%,var(--scrim-strong)_35%,var(--scrim-strong)_65%,var(--void)_100%)]"></div>
  </div>

  <div class="container relative flex max-w-4xl flex-col items-center gap-7 text-center">
    <span class="ss-eyebrow">Free to play · Pro to improve</span>
    <SectionHeading level="h2" size="cta" glow={true} title="Know the number." accent="Hit the shot." />
    <p class="max-w-xl text-body-lg text-mist">
      Live yardage, a scorecard that keeps up, and a handicap that shows your progress. Get it before your next tee time.
    </p>
    <StoreButtons align="center" />
    <p class="text-caption text-mist">No ads · No sign-up · Free to start</p>
  </div>
</section>

---
import FooterColumn from './FooterColumn.astro';
import { LEGAL_LINKS, PRODUCT_LINKS } from '../data/navigation';

const currentYear = new Date().getFullYear();
---
<footer class="border-t border-line bg-void pb-10 pt-16">
  <div class="container">
    <div class="mb-14 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="flex flex-col gap-4 md:col-span-6">
        <a href="/" class="ss-wordmark self-start rounded-sm text-[26px] text-ice">Golf GPS</a>
        <p class="max-w-sm text-subhead text-mist">
          Precision distance and course management for golfers of every level.
        </p>
      </div>

      <FooterColumn heading="Product" links={PRODUCT_LINKS} />
      <FooterColumn heading="Legal" links={LEGAL_LINKS} />
    </div>

    <div class="flex flex-col items-center justify-between gap-3 border-t border-line pt-6 md:flex-row">
      <p class="text-caption text-mist">© {currentYear} Golf GPS · All rights reserved</p>
      <p class="text-caption text-mist">Made for the love of the game</p>
    </div>
  </div>
</footer>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  loading: 'eager' | 'lazy';
  sizes: string;
}

const { src, alt, loading, sizes } = Astro.props;
---
<div class="relative">
  <div
    class="absolute -inset-12 rounded-full blur-3xl opacity-30 bg-[radial-gradient(closest-side,var(--flare),transparent)]"
    aria-hidden="true"
  ></div>
  <div class="ss-media relative">
    <Image
      src={src}
      alt={alt}
      widths={[320, 480, 720, 960]}
      sizes={sizes}
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : 'auto'}
      decoding="async"
      format="webp"
      quality={85}
      class="block w-full h-auto"
    />
  </div>
  <slot />
</div>

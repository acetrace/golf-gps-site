---
import type { TierTone } from '../types/plan';

interface Props {
  included: boolean;
  tone: TierTone;
}

const { included, tone } = Astro.props;

const TONE_CLASSES: Record<TierTone, string> = {
  ice: 'text-ice',
  gold: 'text-gold',
};
---
<td class="py-3.5 text-center">
  {included ? (
    <svg class:list={['inline', TONE_CLASSES[tone]]} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-label="Included" role="img"><path d="M20 6 9 17l-5-5" /></svg>
  ) : (
    <span class="text-mist" aria-label="Not included" role="img">–</span>
  )}
</td>

---
import SectionHeading from './SectionHeading.astro';
import TierCell from './TierCell.astro';
import { TIER_ROWS } from '../data/plans';
---
<section id="pro" class="relative scroll-mt-20 py-20 lg:py-28">
  <div class="container grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-20">
    <div class="flex flex-col gap-5 lg:col-span-5">
      <span class="ss-eyebrow">Free and Pro</span>
      <SectionHeading level="h2" size="section" glow={false} title="Free to play." accent="Pro to improve." />
      <p class="text-body-lg text-mist">
        Yardage, scorecard and round history cost nothing, with no ads. GolfGPS Pro adds the tools that make you better: a real handicap estimate, stats and trends, and every shot on the map.
      </p>
    </div>

    <div class="ss-card p-4.5 lg:col-span-7 md:p-6">
      <table class="w-full border-collapse text-left">
        <caption class="sr-only">Features in the free plan and in GolfGPS Pro</caption>
        <thead>
          <tr class="ss-tag text-mist">
            <th scope="col" class="pb-3 font-medium">Feature</th>
            <th scope="col" class="w-20 pb-3 text-center font-medium">Free</th>
            <th scope="col" class="w-20 pb-3 text-center font-medium text-gold">Pro</th>
          </tr>
        </thead>
        <tbody>
          {TIER_ROWS.map((row) => (
            <tr class="border-t border-line">
              <th scope="row" class="py-3.5 pr-3 text-body font-normal text-ice">{row.label}</th>
              <TierCell included={row.free} tone="ice" />
              <TierCell included={row.pro} tone="gold" />
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

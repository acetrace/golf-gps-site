---
import ScreenshotFrame from './ScreenshotFrame.astro';
import FeatureFocus from './FeatureFocus.astro';
import FeatureDetails from './FeatureDetails.astro';
import SectionHeading from './SectionHeading.astro';
import type { Feature, SpotlightSide } from '../types/feature';

interface Props {
  feature: Feature;
  index: string;
  side: SpotlightSide;
}

const { feature, index, side } = Astro.props;

const SIDE_ORDER: Record<SpotlightSide, { media: string; text: string }> = {
  left: { media: 'lg:order-1', text: 'lg:order-2' },
  right: { media: 'lg:order-2', text: 'lg:order-1' },
};
---
<section id={feature.id} class="relative scroll-mt-20 overflow-hidden py-20 lg:py-28" data-feature>
  <div class="container">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-20">
      <div class={`lg:col-span-5 ${SIDE_ORDER[side].media}`}>
        <div class="mx-auto max-w-[300px] lg:max-w-[340px]">
          <ScreenshotFrame src={feature.screenshot} alt={feature.screenshotAlt} loading="lazy" sizes="(min-width: 1024px) 340px, 300px">
            <FeatureFocus initial={feature.details[0].focus} />
          </ScreenshotFrame>
        </div>
      </div>

      <div class={`flex flex-col gap-6 lg:col-span-7 ${SIDE_ORDER[side].text}`}>
        <div class="flex items-center gap-3">
          <span class="ss-eyebrow">{index} · {feature.eyebrow}</span>
          {feature.pro && <span class="ss-badge">Pro</span>}
        </div>
        <SectionHeading level="h2" size="section" glow={false} title={feature.title} accent={feature.accent} />
        <p class="max-w-xl text-body-lg text-mist">{feature.body}</p>
        <FeatureDetails featureId={feature.id} featureLabel={feature.eyebrow} details={feature.details} />
      </div>
    </div>
  </div>
</section>

<script>
  function requireElement(root: ParentNode, selector: string): HTMLElement {
    const element = root.querySelector<HTMLElement>(selector);
    if (!element) throw new Error(`Feature spotlight is missing ${selector}`);
    return element;
  }

  function requireData(element: HTMLElement, key: string): string {
    const value = element.dataset[key];
    if (value === undefined) throw new Error(`Feature detail trigger is missing data-${key}`);
    return value;
  }

  function selectDetail(section: HTMLElement, trigger: HTMLElement): void {
    const id = requireData(trigger, 'detailTrigger');
    requireElement(section, '[data-focus]').setAttribute('style', requireData(trigger, 'focusStyle'));
    requireElement(section, `[data-detail-panel="${id}"]`);
    section.querySelectorAll<HTMLElement>('[data-detail-trigger]').forEach((button) => {
      button.setAttribute('aria-pressed', button.dataset.detailTrigger === id ? 'true' : 'false');
    });
    section.querySelectorAll<HTMLElement>('[data-detail-panel]').forEach((panel) => {
      panel.hidden = panel.dataset.detailPanel !== id;
    });
  }

  document.querySelectorAll<HTMLElement>('[data-feature]').forEach((section) => {
    section.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const trigger = event.target.closest<HTMLElement>('[data-detail-trigger]');
      if (trigger) selectDetail(section, trigger);
    });
  });
</script>

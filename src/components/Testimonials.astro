---
import SectionHeading from './SectionHeading.astro';
import testimonials from '../data/testimonials.yaml';
---
<section id="testimonials" class="relative scroll-mt-20 py-20 lg:py-28">
  <div class="container">
    <div class="mb-12 flex max-w-2xl flex-col gap-5 lg:mb-16">
      <span class="ss-eyebrow">Reviews</span>
      <SectionHeading level="h2" size="section" glow={false} title="What golfers" accent="say." />
    </div>

    <div class="grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-4">
      {testimonials.map((t) => (
        <article class="ss-card flex flex-col gap-5 p-4.5">
          <div class="flex items-center gap-3">
            <img
              src={`/images/testimonials/${t.id}.jpg`}
              alt=""
              width="44"
              height="44"
              loading="lazy"
              class="h-11 w-11 shrink-0 rounded-full bg-raised object-cover"
            />
            <div class="flex min-w-0 flex-col gap-1">
              <h3 class="truncate text-title-3 text-ice">{t.name}</h3>
              <span class="ss-tag text-gold">Rated {t.rating} / 5</span>
            </div>
          </div>
          <p class="text-body text-ice">{t.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

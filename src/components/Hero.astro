---
import StoreButtons from './StoreButtons.astro';
import StatReadout from './StatReadout.astro';
import SectionHeading from './SectionHeading.astro';
import ScreenshotFrame from './ScreenshotFrame.astro';
import { HERO_STATS } from '../data/hero';
import rangefinder from '../assets/screenshots/rangefinder.png';
---
<section class="ss-ground relative overflow-hidden pt-36 pb-20 lg:pt-44 lg:pb-28">
  <svg
    class="pointer-events-none absolute inset-0 h-full w-full"
    viewBox="0 0 1440 900"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
  >
    <defs>
      <linearGradient id="hero-tracer" x1="0" y1="1" x2="1" y2="0">
        <stop offset="0" stop-color="var(--flare)" />
        <stop offset="1" stop-color="var(--volt)" />
      </linearGradient>
    </defs>
    <path class="ss-tracer ss-tracer--glow ss-tracer--draw" pathLength="1" stroke="url(#hero-tracer)" d="M 660 1000 C 760 320, 1000 90, 1330 130" />
    <path class="ss-tracer ss-tracer--draw" pathLength="1" stroke="url(#hero-tracer)" d="M 660 1000 C 760 320, 1000 90, 1330 130" />
    <circle class="ss-lock-in" cx="1330" cy="130" r="7" fill="#FFFFFF" />
  </svg>

  <div class="container relative">
    <div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-16">
      <div class="flex flex-col gap-7 lg:col-span-7">
        <span class="ss-eyebrow">Rangefinder · Scorecard · Handicap</span>

        <SectionHeading level="h1" size="hero" glow={true} title="Golf GPS" accent="Rangefinder" />

        <p class="max-w-lg text-body-lg text-mist">
          Live yardage on a satellite view of every hole. Score as you walk, track every shot, and watch your handicap drop.
        </p>

        <StoreButtons align="start" />

        <div class="grid max-w-xl grid-cols-3 gap-2.5 pt-2">
          {HERO_STATS.map((stat) => <StatReadout {...stat} />)}
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="mx-auto max-w-[320px] lg:max-w-[380px]">
          <ScreenshotFrame
            src={rangefinder}
            alt="Golf GPS rangefinder showing 156 yards to pin on an aerial course view"
            loading="eager"
            sizes="(min-width: 1024px) 380px, 320px"
          >
            <span class="ss-glass-tag absolute -left-4 top-1/3 sm:-left-10">
              <span class="h-1.5 w-1.5 rounded-full bg-volt" aria-hidden="true"></span>
              Locked · 156 yd to pin
            </span>
          </ScreenshotFrame>
        </div>
      </div>
    </div>
  </div>
</section>

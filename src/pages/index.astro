---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import Spotlight from '../components/Spotlight.astro';
import Extras from '../components/Extras.astro';
import PlanTable from '../components/PlanTable.astro';
import CTA from '../components/CTA.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { FEATURES } from '../data/features';
---
<Layout
  title="Golf GPS · Rangefinder, Scorecard, Shot Tracking"
  description="Live GPS yardage on a satellite view of every hole, a scorecard that keeps up, shot tracking and a handicap estimate. Free on iPhone, no ads."
>
  <NavBar />
  <main>
    <Hero />
    {FEATURES.map((feature, i) => (
      <Spotlight
        feature={feature}
        index={String(i + 1).padStart(2, '0')}
        side={i % 2 === 0 ? 'left' : 'right'}
      />
    ))}
    <Extras />
    <PlanTable />
    <CTA />
  </main>
  <SiteFooter />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SectionHeading from '../components/SectionHeading.astro';
---
<Layout title="Off the fairway · Golf GPS" description="Page not found.">
  <NavBar />
  <main class="ss-ground flex min-h-[80vh] flex-col items-center justify-center gap-7 px-5 pb-24 pt-36 text-center">
    <span class="ss-eyebrow">Lost ball · 404</span>
    <SectionHeading level="h1" size="error" glow={false} title="Off the" accent="fairway." />
    <p class="max-w-md text-body-lg text-mist">
      That page is in the rough. Walk it back to the tee and try a different line.
    </p>
    <a href="/" class="ss-btn ss-btn--primary">Back to the clubhouse</a>
  </main>
  <SiteFooter />
</Layout>
